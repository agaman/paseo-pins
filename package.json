{
  "name": "paseo-pins",
  "private": true,
  "version": "0.1.2",
  "description": "Useful workspace resources, kept current by your agents.",
  "license": "MIT",
  "author": "Alex Gaman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agaman/paseo-pins.git"
  },
  "homepage": "https://github.com/agaman/paseo-pins#readme",
  "bugs": {
    "url": "https://github.com/agaman/paseo-pins/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "workspace",
    "pins"
  ],
  "files": [
    "LICENSE",
    "paseo-plugin.json",
    "OVERVIEW.md",
    "assets/*.png",
    "docs/help.md",
    "docs/configuration.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "lint": "biome check --formatter-enabled=false --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "fix": "biome check --write --error-on-warnings .",
    "knip": "knip",
    "duplicates": "jscpd .",
    "check:distribution": "node --import tsx tools/ci/check-distribution.ts",
    "release": "node --import tsx tools/release.ts",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run knip && npm run duplicates && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@getpaseo/client": "0.15.4",
    "@getpaseo/plugin": "0.15.4",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "type": "module"
}
