      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "id": "menu-inset",
      "label": "Menu inset",
      "var": "--menu-inset",
      "type": "range",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "id": "dot-size",
      "label": "Unread dot",
