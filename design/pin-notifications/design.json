  "tweaks": [
    {
      "id": "row-padding",
      "label": "Row padding",
      "var": "--row-padding",
      "type": "range",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "id": "menu-inset",
      "label": "Menu inset",
      "var": "--menu-inset",
      "type": "range",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "id": "dot-size",
      "label": "Unread dot",
      "var": "--dot-size",
      "type": "range",
      "min": 3,
      "max": 7,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "id": "unread-weight",
      "label": "Unread title weight",
      "var": "--unread-weight",
      "type": "select",
      "options": [
        {
          "label": "Medium",
          "value": "500"
        },
        {
          "label": "Semibold",
          "value": "600"
        }
      ],
      "default": "500"
    }
  ]
}
