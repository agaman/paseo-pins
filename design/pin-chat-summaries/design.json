  "tweaks": [
    {
      "id": "row-padding",
      "label": "Row spacing",
      "var": "--row-padding",
      "type": "range",
      "min": 6,
      "max": 14,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "id": "card-radius",
      "label": "Block corners",
      "var": "--card-radius",
      "type": "range",
      "min": 4,
      "max": 14,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "id": "update-reasons",
      "label": "Update reasons",
      "var": "--reason-display",
      "type": "toggle",
      "on": "block",
      "off": "none",
      "default": true
    }
  ]
