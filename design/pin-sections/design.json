{
  "version": 1,
  "title": "Pins · Sections",
  "kind": "prototype",
  "description": "Flat agent-managed sections with quiet headings. Unsectioned pins stay first; empty sections are hidden. Existing notification messages and global acknowledgment are preserved; chat stays flat.",
  "artboards": [
    {
      "id": "desktop-light",
      "title": "Grouped menu · Light",
      "file": "desktop-light.html",
      "width": 440,
      "height": 900,
      "group": "Desktop"
    },
    {
      "id": "desktop-dark",
      "title": "Grouped menu · Dark",
      "file": "desktop-dark.html",
      "width": 440,
      "height": 900,
      "group": "Desktop"
    },
    {
      "id": "mobile-light",
      "title": "Grouped menu · Mobile light",
      "file": "mobile-light.html",
      "width": 390,
      "height": 1000,
      "group": "Mobile"
    },
    {
      "id": "mobile-dark",
      "title": "Grouped menu · Mobile dark",
      "file": "mobile-dark.html",
      "width": 390,
      "height": 1000,
      "group": "Mobile"
    },
    {
      "id": "long-label",
      "title": "Long section name",
      "file": "long-label.html",
      "width": 440,
      "height": 1000,
      "group": "States"
    },
    {
      "id": "ungrouped",
      "title": "No sections",
      "file": "ungrouped.html",
      "width": 440,
      "height": 900,
      "group": "States"
    },
    {
      "id": "empty",
      "title": "Empty list",
      "file": "empty.html",
      "width": 440,
      "height": 500,
      "group": "States"
    },
    {
      "id": "chat",
      "title": "Chat stays flat",
      "file": "chat.html",
      "width": 720,
      "height": 650,
      "group": "Chat"
    }
  ],
  "tweaks": [
    {
      "id": "heading-size",
      "label": "Heading size",
      "var": "--heading-size",
      "type": "range",
      "min": 10,
      "max": 13,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "id": "heading-gap",
      "label": "Space above heading",
      "var": "--heading-gap",
      "type": "range",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "px",
      "default": 7
    }
  ]
}
